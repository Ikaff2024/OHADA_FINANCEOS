PORT=3050
APP_URL=http://localhost:3050
OHADA_DB_RUNTIME=sqlite
OHADA_DB_PATH=data/financeos.sqlite
OHADA_STORAGE_DIR=storage/uploads
OHADA_DEFAULT_ADMIN_EMAIL=admin@demo.ohada
OHADA_DEFAULT_ADMIN_PASSWORD=change-me-before-production
# Utilises par `db:pg:bootstrap` sur une base PostgreSQL vide.
OHADA_DEFAULT_ORGANIZATION_ID=demo-company
OHADA_DEFAULT_COMPANY_NAME=Entreprise OHADA
OHADA_DEFAULT_COUNTRY=CI
OHADA_DEFAULT_CURRENCY=XOF
OHADA_DEFAULT_FISCAL_YEAR_START=2026-01-01
OHADA_DEFAULT_FISCAL_YEAR_END=2026-12-31
OHADA_DEFAULT_ADMIN_NAME=Administrateur
OHADA_SESSION_TTL_HOURS=12
OHADA_JOB_WORKER_INTERVAL_MS=1500
OHADA_AUTH_RATE_LIMIT_WINDOW_MS=900000
OHADA_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
OHADA_EXPOSE_AUTH_TOKENS=false
OHADA_CORS_ALLOWED_ORIGINS=
# Observabilite et durcissement HTTP
LOG_LEVEL=info
OHADA_MAX_REQUEST_BODY_BYTES=2097152
OHADA_REQUEST_TIMEOUT_MS=30000
OHADA_ENABLE_HSTS=false
# Si defini, /api/metrics exige Authorization: Bearer <token>.
OHADA_METRICS_TOKEN=

# SMTP Configuration for Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@financeos.com
# PostgreSQL target for production migrations.
# Run `npm.cmd run db:migrate:pg` after setting this URL.
# Set OHADA_DB_RUNTIME=postgres only after migrations and seed have been applied.
DATABASE_URL=postgres://ohada:change-me@localhost:5432/ohada_financeos
PGSSLMODE=disable
OHADA_PG_CONNECTION_TIMEOUT_MS=3000
# Optionnel pour executer pg_dump/pg_restore dans un conteneur PostgreSQL local.
PG_DOCKER_CONTAINER=
# Optionnel si les outils PostgreSQL natifs ne sont pas dans le PATH.
PG_BIN_DIR=

# API Keys
GEMINI_API_KEY=
