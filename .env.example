PORT=3050
OHADA_DB_RUNTIME=sqlite
OHADA_DB_PATH=data/financeos.sqlite
OHADA_STORAGE_DIR=storage/uploads
OHADA_DEFAULT_ADMIN_EMAIL=admin@demo.ohada
OHADA_DEFAULT_ADMIN_PASSWORD=change-me-before-production
OHADA_SESSION_TTL_HOURS=12
OHADA_JOB_WORKER_INTERVAL_MS=1500

# PostgreSQL target for production migrations.
# Run `npm.cmd run db:migrate:pg` after setting this URL.
# Set OHADA_DB_RUNTIME=postgres only after migrations and seed have been applied.
DATABASE_URL=postgres://ohada:change-me@localhost:5432/ohada_financeos
PGSSLMODE=disable
