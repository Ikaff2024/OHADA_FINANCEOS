APP_URL=https://financeos.example.com
OHADA_HTTP_PORT=3050

POSTGRES_USER=ohada
# Utiliser une valeur aleatoire URL-safe (lettres et chiffres recommandes).
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ohada_financeos
PG_DOCKER_CONTAINER=ohada-financeos-pilot-db
OHADA_PG_CONNECTION_TIMEOUT_MS=3000

OHADA_DEFAULT_ORGANIZATION_ID=demo-company
OHADA_DEFAULT_COMPANY_NAME=Entreprise OHADA
OHADA_DEFAULT_COUNTRY=CI
OHADA_DEFAULT_CURRENCY=XOF
OHADA_DEFAULT_FISCAL_YEAR_START=2026-01-01
OHADA_DEFAULT_FISCAL_YEAR_END=2026-12-31
OHADA_DEFAULT_ADMIN_EMAIL=admin@example.com
OHADA_DEFAULT_ADMIN_NAME=Administrateur
OHADA_DEFAULT_ADMIN_PASSWORD=replace-with-a-long-random-password

OHADA_SESSION_TTL_HOURS=12
OHADA_JOB_WORKER_INTERVAL_MS=1500
OHADA_AUTH_RATE_LIMIT_WINDOW_MS=900000
OHADA_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
OHADA_EXPOSE_AUTH_TOKENS=false
OHADA_CORS_ALLOWED_ORIGINS=https://financeos.example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

GEMINI_API_KEY=
