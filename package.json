{
  "name": "ohada-financeos-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP local pour OHADA FinanceOS: comptabilite SYSCOHADA, ecritures, balance, bilan et compte de resultat.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --no-warnings src/server.js",
    "start": "node --env-file=.env --no-warnings src/server.js",
    "lint": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\"",
    "test": "node --test \"test/**/*.test.js\" && node src/check.js && node src/check-server.js",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "check": "node src/check.js",
    "check:e2e": "node src/check-server.js",
    "check:pg:e2e": "node scripts/check-postgres-smoke.js",
    "check:pg:full": "node scripts/check-postgres-full.js",
    "check:smtp": "node scripts/check-smtp-local.js",
    "smtp:check": "node --env-file=.env scripts/check-smtp.js",
    "db:migrate:pg": "node scripts/migrate-postgres.js",
    "db:pg:bootstrap": "node scripts/bootstrap-postgres.js",
    "db:pg:dump": "node scripts/export-postgres-seed.js",
    "db:pg:seed": "node scripts/seed-postgres.js",
    "db:pg:setup": "node scripts/setup-postgres.js",
    "db:pg:check": "node scripts/check-postgres-runtime.js",
    "db:pg:backup": "node --env-file=.env scripts/backup-postgres.js",
    "db:pg:restore": "node --env-file=.env scripts/restore-postgres.js",
    "pilot:up": "docker compose --env-file .env.production -f compose.pilot.yml up -d --build",
    "pilot:down": "docker compose --env-file .env.production -f compose.pilot.yml down",
    "pilot:logs": "docker compose --env-file .env.production -f compose.pilot.yml logs -f app",
    "pilot:backup": "node --env-file=.env.production scripts/backup-postgres.js",
    "pilot:restore": "node --env-file=.env.production scripts/restore-postgres.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.8.4"
  }
}
